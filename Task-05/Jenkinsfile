pipeline {
    agent any

    environment {
        VERSION = "${BUILD_NUMBER}"
        AWS_ACCOUNT_ID = "906543084508"
        REGION = "ap-south-1"
        ECR = "906543084508.dkr.ecr.ap-south-1.amazonaws.com"
    }

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t frontend:${VERSION} ./Task-04/frontend'
                sh 'docker build -t backend:${VERSION} ./Task-04/backend'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'sonar-scanner'

                    withSonarQubeEnv('SonarQube-Server') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                            -Dsonar.projectKey=three-tier-blog-app \
                            -Dsonar.sources=. \
                            -Dsonar.host.url=http://35.154.96.135:9000
                        """
                    }
                }
            }
        }

        stage('Quality Gate Check') {
            steps {
                script {
                    timeout(time: 5, unit: 'MINUTES') {
                        def qg = waitForQualityGate()

                        if (qg.status != 'OK') {
                            error "Pipeline stopped due to Quality Gate failure: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region $REGION |
                    docker login --username AWS --password-stdin $ECR

                    docker tag frontend:${VERSION} $ECR/blog-frontend:${VERSION}
                    docker tag backend:${VERSION} $ECR/blog-backend:${VERSION}

                    docker push $ECR/blog-frontend:${VERSION}
                    docker push $ECR/blog-backend:${VERSION}
                '''
            }
        }
    }
}
