pipeline {
  agent any
  environment {
    VERSION = "${BUILD_NUMBER}"
    ECR     = "906543084508.dkr.ecr.ap-south-1.amazonaws.com"
    REGION  = "ap-south-1"
  }
  stages {
    stage('Build') {
      steps {
        sh 'docker build -t frontend:${VERSION} ./Task-04/frontend'
        sh 'docker build -t backend:${VERSION} ./Task-04/backend'
      }
    }
    stage('Push to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region $REGION | docker login --username AWS --password-stdin $ECR
          docker tag frontend:${VERSION} $ECR/blog-frontend:${VERSION}
          docker tag backend:${VERSION} $ECR/blog-backend:${VERSION}
          docker push $ECR/blog-frontend:${VERSION}
          docker push $ECR/blog-backend:${VERSION}
        '''
      }
    }
  }
}
